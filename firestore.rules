rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saved_reports/{reportId} {
      allow read, write: if true;
    }
    match /officer_partitions/{partitionKey}/reports/{reportId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
